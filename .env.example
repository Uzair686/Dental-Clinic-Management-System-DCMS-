# Local SQLite file (default if DATABASE_URL is unset)
# DATABASE_URL=file:./data/clinic.db

# PostgreSQL cloud (Neon, Supabase, Railway, Azure, AWS RDS, etc.)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Turso / libSQL cloud
# DATABASE_URL=libsql://YOUR-DB.turso.io
# DATABASE_AUTH_TOKEN=YOUR_TURSO_TOKEN
